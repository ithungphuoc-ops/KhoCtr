# Service account project hpcons-portal — dùng để verify session cookie SSO
# (account.hpcore.vn) + đọc app_permissions/{uid}.warehouse. Lấy giá trị thật
# từ .env của các app khác trong workspace (hpcons-quatang, ITAsset...).
HPCORE_FIREBASE_SERVICE_ACCOUNT=

# Service account project hpcons-khoctr — Firestore nghiệp vụ kho (cong_trinh,
# phieu, hang_hoa, ...). Lấy giá trị thật từ api/.env hiện có (biến
# KHOCTR_FIREBASE_SERVICE_ACCOUNT), KHÔNG đổi project, chỉ đổi cách đọc.
KHOCTR_FIREBASE_SERVICE_ACCOUNT=

# ── GĐ4: Mã hoá API key AI theo công trình (lib/crypto/fernet.ts) ──
# BẮT BUỘC lấy đúng giá trị hiện có trong api/.env (biến ENCRYPTION_KEY) —
# dùng chung thuật toán Fernet, đổi giá trị khác sẽ không giải mã được
# ciphertext cũ đang lưu trong Firestore (project_ai_config.api_key_enc).
ENCRYPTION_KEY=
# Tuỳ chọn — nhiều key phân cách bằng dấu phẩy, dùng khi cần rotate key (thử
# lần lượt từng key khi giải mã). Không set thì chỉ dùng ENCRYPTION_KEY ở trên.
ENCRYPTION_KEYS=

# ── Cloudflare R2 (lưu ảnh/PDF chứng từ phiếu, xem lib/r2.ts) ──
# Bucket private, bắt buộc phải có 2 biến access key dưới đây thì upload/xem
# ảnh chứng từ mới hoạt động được (không có giá trị default).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Có giá trị default hardcode trong lib/r2.ts — chỉ cần set nếu đổi bucket/account.
R2_BUCKET=
R2_ACCOUNT_ID=

# ── Cron tự xóa vĩnh viễn phiếu trong thùng rác sau 30 ngày (app/api/cron/purge-phieu) ──
# Chuỗi bí mật tự đặt (ngẫu nhiên, dài) — set cùng giá trị này trên Vercel →
# Settings → Environment Variables (Production) để Vercel Cron gọi được route.
CRON_SECRET=

# ── GĐ4: Fallback API key AI khi công trình chưa cấu hình riêng (ai-config) ──
# Lấy đúng giá trị từ api/.env hiện có, không bắt buộc phải set đủ cả 3 nếu
# chỉ dùng 1 provider.
CLAUDE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
